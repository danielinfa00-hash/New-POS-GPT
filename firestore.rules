rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    function isCashier() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CAJERO');
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || isCashier();
      allow delete: if isAdmin() && resource.data.salesCount == 0;
    }

    match /settings/counters {
      allow get: if signedIn();
      allow create: if isCashier() && request.resource.data.saleOrderNumber == 1;
      allow update: if isCashier()
        && request.resource.data.saleOrderNumber == resource.data.saleOrderNumber + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saleOrderNumber', 'updatedAt']);
      allow delete, list: if false;
    }

    match /settings/tablesConfig {
      allow read: if signedIn();
      allow write: if isCashier();
    }

    match /sales/{saleId} {
      allow create: if isCashier()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.saleNumber == getAfter(/databases/$(database)/documents/settings/counters).data.saleOrderNumber;
      allow get, list: if isAdmin() || (isCashier() && resource.data.userId == request.auth.uid);
      // La venta se conserva para auditoría: solo se permite anularla y nunca
      // modificar sus importes, artículos ni eliminarla.
      allow update: if (isAdmin() || (isCashier() && resource.data.userId == request.auth.uid))
        && resource.data.status == 'COMPLETED'
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelReason is string
        && request.resource.data.cancelReason.size() > 2
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelReason']);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if isCashier()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'NUEVO'
        && request.resource.data.saleNumber == getAfter(/databases/$(database)/documents/settings/counters).data.saleOrderNumber;
      allow get, list: if signedIn();
      allow update, delete: if false;
    }

    match /tableOrders/{tableId} {
      allow read: if signedIn();
      allow create, update: if isCashier();
      allow delete: if false;
    }

    // Business collections remain closed until their respective phases.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
